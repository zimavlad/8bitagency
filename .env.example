# Лише назви. Значення — у Coolify або в локальному .env (не в git).
# Без ключа гра йде на підставній моделі й нічого не коштує.
ANTHROPIC_API_KEY=
# Моделі (дефолти в src/lib/server/app.ts)
AGENCY_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-opus-5-5
CLIENT_MODEL=claude-sonnet-5-5
GPT_MODEL=claude-haiku-4-5
DATA_DIR=/data
PORT=3000
HOST=0.0.0.0
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
GAME_PASSWORD=
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
